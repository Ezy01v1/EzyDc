# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=3100
# Orígenes permitidos (CORS + Socket.IO), separados por coma
CORS_ORIGINS=http://localhost:5300

# ─── PostgreSQL ─────────────────────────────────────────────
# Local: Postgres instalado en el sistema, o una rama "dev" gratuita de Neon.
# Neon:     DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/ezydc?sslmode=require&pgbouncer=true&connection_limit=5
#           DIRECT_URL=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/ezydc?sslmode=require
# Supabase: DATABASE_URL=...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
#           DIRECT_URL=...pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ezydc?connection_limit=10
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ezydc

# ─── Redis (opcional en local) ──────────────────────────────
# Vacío = caché y adapter en memoria (una sola instancia).
# Upstash: rediss://default:TOKEN@xxx.upstash.io:6379
REDIS_URL=

# ─── Auth ───────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# ─── Cookies ────────────────────────────────────────────────
# Producción: COOKIE_SECURE=true. Con rewrite /api en Vercel/Netlify (mismo origen) basta SameSite=lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ─── Métricas ───────────────────────────────────────────────
# Si se define, GET /api/metrics exige la cabecera x-metrics-token
METRICS_TOKEN=

# ─── Fases siguientes (aún no usadas) ───────────────────────
# LIVEKIT_URL=wss://xxx.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
